# SOLARA MVP ledger payout dashboard

PORT=3000
PUBLIC_URL=http://localhost:3000

SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=
SOLR_MINT=
SOLR_DECIMALS=9
ADMIN_WALLET_PUBLIC_KEY=
ADMIN_API_KEY=dev-admin-key
DATABASE_URL=./data/solara-ledger.sqlite
ENABLE_AUTO_PAYOUTS=false
PAYOUT_INTERVAL_MINUTES=30
REWARD_WALLET_SECRET_JSON=
NETWORK_START_AT_ISO=2026-06-08T18:00:00.000Z
ALLOWED_ORIGINS=

# Local/manual payouts may use REWARD_WALLET_KEYPAIR_PATH in .env.admin.
# Do not set private keys in Vercel. Railway hot-wallet payouts are optional.
